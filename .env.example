# Supabase browser configuration
# Create a separate development project and copy its public values here.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your_public_publishable_key

# Optional: enables GIF search in supported content builders.
VITE_GIPHY_API_KEY=your_public_giphy_api_key
